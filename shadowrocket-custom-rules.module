#!name=Custom Rules
#!desc=Personal Shadowrocket routing rules for Tailscale, Apple services, and future additions.

tun-excluded-routes = 10.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 255.255.255.255/32, 239.255.255.250/32, ff02::fb/128

[Rule]

DOMAIN-KEYWORD,yueyou,DIRECT
DOMAIN-KEYWORD,yuepenghk,DIRECT
DOMAIN-KEYWORD,tjfanyue,DIRECT
DOMAIN-KEYWORD,tjxilan,DIRECT
DOMAIN-KEYWORD,tjshuchen,DIRECT

# Tailscale 控制服务器、登录、日志和 DERP 中继走代理
DOMAIN-SUFFIX,tailscale.com,PROXY
DOMAIN-SUFFIX,tailscale.io,PROXY

# Apple Account
DOMAIN,account.apple.com,DIRECT
DOMAIN,idmsa.apple.com,DIRECT
DOMAIN,gsa.apple.com,DIRECT

# iCloud, CloudKit, iWork, and push services
DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT
DOMAIN-SUFFIX,apple-livephotoskit.com,DIRECT
DOMAIN-SUFFIX,apzones.com,DIRECT
DOMAIN-SUFFIX,cdn-apple.com,DIRECT
DOMAIN-SUFFIX,gc.apple.com,DIRECT
DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,icloud.com.cn,DIRECT
DOMAIN-SUFFIX,icloud.apple.com,DIRECT
DOMAIN-SUFFIX,icloud-content.com,DIRECT
DOMAIN-SUFFIX,iwork.apple.com,DIRECT
DOMAIN-SUFFIX,push.apple.com,DIRECT

# iCloud Mail
DOMAIN-SUFFIX,me.com,DIRECT
DOMAIN-SUFFIX,mac.com,DIRECT
